
import { getSql, json } from '../_db.js';

export default async function handler(req, res) {
  try {
    const sql = getSql();

    if (req.method === 'POST') {
      const body = req.body || {};
      const titulo = String(body.titulo || '').trim();
      const categoria = String(body.categoria || '').trim();
      const ubicacion = String(body.ubicacion || '').trim();
      const historia = String(body.historia || '').trim();
      const anonimo = body.anonimo !== false && body.anonimo !== 'false';

      if (!titulo || !categoria || !historia) {
        return json(res, 400, {
          error: 'Completa el título, la categoría y la historia.'
        });
      }

      if (titulo.length > 100 || categoria.length > 50 ||
          ubicacion.length > 60 || historia.length > 1500) {
        return json(res, 400, {
          error: 'Alguno de los campos supera la longitud permitida.'
        });
      }

      const rows = await sql`
        INSERT INTO casos
          (titulo, categoria, ubicacion, historia, anonimo, estado)
        VALUES
          (${titulo}, ${categoria}, ${ubicacion}, ${historia}, ${anonimo}, 'pendiente')
        RETURNING id
      `;

      return json(res, 201, {
        ok: true,
        mensaje: 'Caso enviado para revisión.',
        id: rows[0].id
      });
    }

    if (req.method === 'GET') {
      const rows = await sql`
        SELECT id, titulo, categoria, ubicacion, historia,
               anonimo, estado, creado_en
        FROM casos
        WHERE estado = 'publicado'
        ORDER BY creado_en DESC
        LIMIT 100
      `;

      return json(res, 200, { casos: rows });
    }

    res.setHeader('Allow', 'GET, POST');
    return json(res, 405, { error: 'Método no permitido.' });
  } catch (error) {
    console.error('Error en /api/casos:', error);
    return json(res, 500, {
      error: 'No se ha podido procesar la solicitud.'
    });
  }
}
